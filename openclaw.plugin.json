{
  "id": "break-delegate",
  "name": "Break Delegate",
  "version": "0.1.0",
  "description": "Take a macOS break while OpenClaw answers familiar Claude Code questions.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "agentId": {
        "type": "string",
        "minLength": 1,
        "description": "Configured agent for tool-free confirmation."
      },
      "workload": {
        "type": "object",
        "properties": {
          "threshold": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "activePointsPerMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "additionalPointsPerMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "humanReplyPoints": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "additionalProperties": false,
        "description": "Break invitation score and weights."
      },
      "historyRoots": {
        "type": "object",
        "properties": {
          "claude": {
            "type": "string",
            "pattern": "^/"
          },
          "codex": {
            "type": "string",
            "pattern": "^/"
          },
          "gstack": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "additionalProperties": false,
        "description": "Absolute local state roots. Only specified sources are imported."
      }
    },
    "additionalProperties": false
  },
  "cliCommands": [
    {
      "name": "break-delegate",
      "description": "Manage break invitations and delegated Claude Code questions",
      "hasSubcommands": true
    }
  ],
  "contracts": {
    "tools": []
  }
}
